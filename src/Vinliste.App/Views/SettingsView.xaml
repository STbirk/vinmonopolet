<UserControl x:Class="Vinliste.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Vinliste.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" FontSize="28" />
            <TextBlock Text="The theme changes at once; everything else when you click Save." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,2,0,20" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource Switch}" Content="Dark theme" IsChecked="{Binding IsDarkTheme}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Keeping up to date" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource Switch}" Content="Check Vinmonopolet for changes in the background"
                              IsChecked="{Binding BackgroundUpdates}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="44,4,0,10"
                               Text="While Vinliste is open it reads Vinmonopolet's wine list one page at a time, picking up new wines, price changes and availability. Progress is saved after every page, so closing the app loses nothing. “Update now” in the sidebar does a full pass at full speed instead." />
                    <ComboBox ItemsSource="{Binding PaceOptions}" SelectedItem="{Binding SelectedPace}" DisplayMemberPath="Label"
                              Width="360" HorizontalAlignment="Left" Margin="44,0,0,0"
                              IsEnabled="{Binding BackgroundUpdates}" />

                    <CheckBox Style="{StaticResource Switch}" Content="Collect ratings in the background"
                              IsChecked="{Binding BackgroundRatings}" Margin="0,20,0,0" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="44,4,0,10"
                               Text="Looks up one wine at a time on the rating sites: favourites first, then wines you have opened, then the core range. Each wine is checked again after 30 days. It is slow on purpose, so the sites are not overloaded; the Activity panel shows each lookup." />
                    <ComboBox ItemsSource="{Binding RatingPaceOptions}" SelectedItem="{Binding SelectedRatingPace}" DisplayMemberPath="Label"
                              Width="360" HorizontalAlignment="Left" Margin="44,0,0,0"
                              IsEnabled="{Binding BackgroundRatings}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="My store" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding StoresHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                    <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding FavoriteStore}" Width="360" HorizontalAlignment="Left"
                              MaxDropDownHeight="420">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Name}" /><Run Text="{Binding Town, StringFormat=' · {0}', TargetNullValue=''}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Stock lists are sorted by distance from this position (your store's, or enter your own):"
                               Style="{StaticResource CaptionText}" Margin="0,14,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="140" Tag="Latitude, e.g. 59.91" Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Width="140" Tag="Longitude, e.g. 10.75" Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Rating sources" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,12"
                               Text="Ratings are looked up through web search and the sites' own pages. Falstaff and Wine Enthusiast are read through a hidden Microsoft Edge view, because they block plain downloads." />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SourceToggle}">
                                <StackPanel Margin="0,0,0,10">
                                    <CheckBox Style="{StaticResource Switch}" Content="{Binding Label}" IsChecked="{Binding IsEnabled}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="44,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,10,0,6" Style="{StaticResource BodyText}">
                        <Run Text="Match strictness: " /><Run Text="{Binding MatchThreshold, StringFormat={}{0:0}}" FontWeight="SemiBold" /><Run Text=" / 100" />
                    </TextBlock>
                    <Slider Minimum="70" Maximum="95" Value="{Binding MatchThreshold}" Width="360" HorizontalAlignment="Left"
                            IsSnapToTickEnabled="True" TickFrequency="1" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="Higher means fewer but surer matches. Producer, vintage and wine-specific words (cuvée, Riserva …) must agree regardless." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Data" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10">
                        <Run Text="The wine database, settings and browser cache are stored in " /><Run Text="{Binding DataFolder, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
                    </TextBlock>
                    <Button Content="Open data folder" HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="Save" Padding="26,9" Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding SavedMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
