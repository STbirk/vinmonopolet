<UserControl x:Class="Vinliste.App.Views.ActivityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Vinliste.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="220"
             d:DataContext="{d:DesignInstance vm:ActivityViewModel}">
    <UserControl.Resources>
        <!-- A terminal stays dark in both themes. -->
        <SolidColorBrush x:Key="TermBackground" Color="#160A0F" />
        <SolidColorBrush x:Key="TermHeader" Color="#21111A" />
        <SolidColorBrush x:Key="TermText" Color="#E9DCDF" />
        <SolidColorBrush x:Key="TermMuted" Color="#8D7480" />
        <FontFamily x:Key="TermFont">Cascadia Mono, Cascadia Code, Consolas, Courier New</FontFamily>

        <Style x:Key="TermButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TermMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="8,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TermText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Source tag colours: one hue per kind of work. -->
        <Style x:Key="SourceText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9A9B1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="catalog"><Setter Property="Foreground" Value="#D9B26A" /></DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="ratings"><Setter Property="Foreground" Value="#E58CA0" /></DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="job"><Setter Property="Foreground" Value="#8FC1E3" /></DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="web"><Setter Property="Foreground" Value="#A08893" /></DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="search"><Setter Property="Foreground" Value="#A08893" /></DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="browser"><Setter Property="Foreground" Value="#A08893" /></DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="app"><Setter Property="Foreground" Value="#9FD3A8" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MessageText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TermText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Detail"><Setter Property="Foreground" Value="#8D7480" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Success"><Setter Property="Foreground" Value="#9FD3A8" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="#E8C07A" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="#F08A8A" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource TermBackground}" CornerRadius="10" Height="220" ClipToBounds="True"
            BorderBrush="#3A2129" BorderThickness="1">
        <DockPanel>
            <!-- Title bar with window dots, like a terminal. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource TermHeader}" CornerRadius="10,10,0,0" Padding="12,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="Web requests" IsChecked="{Binding ShowWebRequests}" VerticalAlignment="Center"
                                  Foreground="{StaticResource TermMuted}" FontSize="11.5" Margin="0,0,12,0" Cursor="Hand"
                                  ToolTip="Also list every page Vinliste downloads" />
                        <Button Style="{StaticResource TermButton}" Command="{Binding CopyCommand}" ToolTip="Copy all lines">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource TermButton}" Command="{Binding ClearCommand}" ToolTip="Clear">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource TermButton}" Command="{Binding ToggleCommand}" ToolTip="Close">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#B4405A" Margin="0,0,5,0" />
                        <Ellipse Width="9" Height="9" Fill="#C8A97E" Margin="0,0,5,0" />
                        <Ellipse Width="9" Height="9" Fill="#6F9F7C" Margin="0,0,12,0" />
                        <TextBlock Text="vinliste — activity" FontFamily="{StaticResource TermFont}" FontSize="12"
                                   Foreground="{StaticResource TermMuted}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ListBox x:Name="LineList" ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0"
                     Padding="10,6" FontFamily="{StaticResource TermFont}" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,1" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#2EFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ActivityLine}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource TermMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource SourceText}" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource MessageText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
