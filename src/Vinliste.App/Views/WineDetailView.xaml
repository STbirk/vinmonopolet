<UserControl x:Class="Vinliste.App.Views.WineDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Vinliste.App.ViewModels"
             xmlns:controls="clr-namespace:Vinliste.App.Controls"
             mc:Ignorable="d" d:DesignWidth="430" d:DesignHeight="900"
             d:DataContext="{d:DesignInstance vm:WineDetailViewModel}">
    <Grid>
        <!-- Nothing selected -->
        <Border Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}"
                Visibility="{Binding Converter={StaticResource CollapsedWhen}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="38" HorizontalAlignment="Center"
                           Foreground="{DynamicResource CorkBrush}" />
                <TextBlock Text="Pick a wine" Style="{StaticResource TitleText}" FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Tasting notes, ratings, price history and stock show up here."
                           Style="{StaticResource CaptionText}" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding Converter={StaticResource VisibleWhen}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Hero -->
                    <Border Background="{DynamicResource HeroBrush}" CornerRadius="10,10,0,0" Padding="20,18,16,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="86" Height="150" CornerRadius="8" Background="#FFFFFFFF" VerticalAlignment="Top" Padding="4">
                                <Image Source="{Binding Row.ImageUrl, TargetNullValue={x:Null}}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource FavoriteToggle}" IsChecked="{Binding IsFavorite}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Row.Name}" Style="{StaticResource TitleText}" FontSize="19" />
                                </DockPanel>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" FontSize="12" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding PriceText}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding FactsText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding PriceChangeText}" FontSize="11.5" Margin="0,3,0,0"
                                           Foreground="{Binding Row.PriceChange, Converter={StaticResource PriceChangeBrush}}"
                                           Visibility="{Binding PriceChangeText, Converter={StaticResource VisibleWhen}}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenVinmonopoletCommand}" Padding="0,2" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" FontSize="11" Margin="0,0,5,0" />
                                            <TextBlock Text="vinmonopolet.no" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Row.Code, StringFormat='Item {0}'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="20,16,20,20">
                        <!-- Score -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="62" Height="62" CornerRadius="31" Background="{Binding Row.BestScore, Converter={StaticResource ScoreBrush}}">
                                <TextBlock Text="{Binding BestScoreText}" FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Row.BestScore}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Best rating" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding BestScoreCaption}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding RateCommand}" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsRating, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="Find ratings" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding RatingMessage}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                                   Visibility="{Binding RatingMessage, Converter={StaticResource VisibleWhen}}" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                                     Visibility="{Binding IsRating, Converter={StaticResource VisibleWhen}}" />

                        <ItemsControl ItemsSource="{Binding Ratings}" Margin="0,0,0,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RatingDisplay}">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Status, StringFormat=' · {0}'}" Style="{StaticResource CaptionText}" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding MatchedName, Converter={StaticResource VisibleWhen}}">
                                                    <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding Url}" Foreground="{DynamicResource AccentBrush}">
                                                        <Run Text="{Binding MatchedName}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="10" Padding="9,3" VerticalAlignment="Top" Margin="8,0,0,0"
                                                    Background="{Binding Score100, Converter={StaticResource ScoreBrush}}"
                                                    Visibility="{Binding Score100, Converter={StaticResource VisibleWhen}}">
                                                <TextBlock Text="{Binding ScoreText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OnPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tasting notes -->
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Padding="4" FontSize="12"
                                    Command="{Binding RefreshDetailsCommand}" ToolTip="Fetch details again from Vinmonopolet" />
                            <TextBlock Text="Tasting notes" Style="{StaticResource SectionTitle}" Margin="0" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                                     Visibility="{Binding IsLoadingDetails, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding DetailsStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                                   Visibility="{Binding DetailsStatus, Converter={StaticResource VisibleWhen}}" />
                        <StackPanel Visibility="{Binding HasTastingNotes, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="COLOUR" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Details.Colour}" Style="{StaticResource BodyText}" Margin="0,0,0,10" />
                            <TextBlock Text="SMELL" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Details.Smell}" Style="{StaticResource BodyText}" Margin="0,0,0,10" />
                            <TextBlock Text="TASTE" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Details.Taste}" Style="{StaticResource BodyText}" Margin="0,0,0,10" />
                        </StackPanel>
                        <TextBlock Text="{Binding DetailsUpdatedText}" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <!-- Characteristics -->
                        <ItemsControl ItemsSource="{Binding Characteristics}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CharacteristicDisplay}">
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding Value, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0}/12}" Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Grapes, food, style -->
                        <StackPanel Visibility="{Binding GrapesText, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,12">
                            <TextBlock Text="GRAPES" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding GrapesText}" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding Food, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
                            <TextBlock Text="GOOD WITH" Style="{StaticResource LabelText}" />
                            <ItemsControl ItemsSource="{Binding Food}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoftBrush}">
                                        <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,0,0,18" Visibility="{Binding Details, Converter={StaticResource VisibleWhen}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="ALLERGENS" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding Details.Allergens, TargetNullValue='–'}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="STORAGE" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding Details.StoragePotential, TargetNullValue='–'}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,8,10">
                                <TextBlock Text="SUGAR · ACID" Style="{StaticResource LabelText}" />
                                <TextBlock Style="{StaticResource BodyText}">
                                    <Run Text="{Binding Details.Sugar, TargetNullValue='–'}" /><Run Text=" · " /><Run Text="{Binding Details.Acid, TargetNullValue='–'}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="CLOSURE · PACKAGE" Style="{StaticResource LabelText}" />
                                <TextBlock Style="{StaticResource BodyText}">
                                    <Run Text="{Binding Details.Cork, TargetNullValue='–'}" /><Run Text=" · " /><Run Text="{Binding Details.PackageType, TargetNullValue='–'}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,8,0">
                                <TextBlock Text="IMPORTER" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding Details.Wholesaler, TargetNullValue='–'}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="METHOD" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding Details.Method, TargetNullValue='–'}" Style="{StaticResource BodyText}" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <!-- Price history -->
                        <TextBlock Text="Price history" Style="{StaticResource SectionTitle}" />
                        <controls:Sparkline Height="54" Margin="0,0,0,18" Points="{Binding PriceHistory}"
                                            Stroke="{DynamicResource AccentBrush}" LabelBrush="{DynamicResource TextSecondaryBrush}" />

                        <!-- Stock -->
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshStockCommand}" Padding="10,4" FontSize="12"
                                    IsEnabled="{Binding IsLoadingStock, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE707;" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="Check stock" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="In stores" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding StockStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                                     Visibility="{Binding IsLoadingStock, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding Stock}" Margin="0,0,0,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StockDisplay}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,2,5,0"
                                                           Foreground="{DynamicResource CorkBrush}"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource VisibleWhen}}" />
                                                <TextBlock Text="{Binding Store}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource CaptionText}" FontSize="11">
                                                <Run Text="{Binding Address}" /><Run Text="{Binding Distance, StringFormat=' · {0}', TargetNullValue=''}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StockLevel, Converter={StaticResource StockText}}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Note -->
                        <TextBlock Text="My note" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 VerticalContentAlignment="Top" Tag="Where you drank it, what you thought…" LostFocus="OnNoteLostFocus" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
