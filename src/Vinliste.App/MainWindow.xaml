<Window x:Class="Vinliste.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Vinliste.App.ViewModels"
        xmlns:views="clr-namespace:Vinliste.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Vinliste" Icon="Assets/vinliste.ico"
        Width="1440" Height="900" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Navigation rail ===== -->
        <Border Background="{DynamicResource NavBackgroundBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,26,20,30">
                    <Image Source="Assets/vinliste-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Vinliste" FontFamily="{StaticResource DisplayFont}" FontSize="21"
                                   Foreground="{DynamicResource NavTextBrush}" />
                        <TextBlock Text="from Vinmonopolet" FontSize="11" Foreground="{DynamicResource NavTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumMatch}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="CELLAR" FontSize="10.5" FontWeight="SemiBold" Margin="24,0,0,8"
                               Foreground="{DynamicResource NavTextMutedBrush}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumMatch}, ConverterParameter=AllWines}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8FD;" Margin="0,0,12,0" />
                            <TextBlock Text="All wines" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumMatch}, ConverterParameter=Favorites}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xEB51;" Margin="0,0,12,0" />
                            <TextBlock Text="Favourites" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumMatch}, ConverterParameter=NewArrivals}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE823;" Margin="0,0,12,0" />
                            <TextBlock Text="New arrivals" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumMatch}, ConverterParameter=PriceDrops}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8C7;" Margin="0,0,12,0" />
                            <TextBlock Text="Price drops" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Catalogue update card -->
                    <Border Margin="14,26,14,0" Padding="14" CornerRadius="10" Background="#1FFFFFFF">
                        <StackPanel>
                            <TextBlock Text="Catalogue" FontWeight="SemiBold" Foreground="{DynamicResource NavTextBrush}" />
                            <TextBlock Text="{Binding StatsText}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap"
                                       Foreground="{DynamicResource NavTextMutedBrush}" />
                            <!-- Background update status: a softly pulsing dot while it works. -->
                            <DockPanel Margin="0,0,0,10" Visibility="{Binding BackgroundText, Converter={StaticResource VisibleWhen}}">
                                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,4,7,0" VerticalAlignment="Top"
                                         Fill="{DynamicResource CorkBrush}"
                                         Visibility="{Binding IsBackgroundActive, Converter={StaticResource VisibleWhen}}">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.4" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{Binding BackgroundText}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource NavTextMutedBrush}"
                                           ToolTip="While Vinliste is open it checks Vinmonopolet slowly in the background (one page a minute by default), so the list stays current without you doing anything." />
                            </DockPanel>
                            <DockPanel Margin="0,-4,0,10" Visibility="{Binding RatingsText, Converter={StaticResource VisibleWhen}}">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                           Margin="0,3,6,0" VerticalAlignment="Top" Foreground="{DynamicResource CorkBrush}"
                                           Opacity="{Binding IsRatingsActive, Converter={StaticResource ActiveOpacity}}" />
                                <TextBlock Text="{Binding RatingsText}" FontSize="10.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="30" Foreground="{DynamicResource NavTextMutedBrush}"
                                           ToolTip="While Vinliste is open it looks up ratings for one wine at a time (every five minutes by default): favourites first, then wines you have opened, then the core range." />
                            </DockPanel>
                            <Button Command="{Binding UpdateCatalogCommand}" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding Job.IsBusy, Converter={StaticResource InverseBool}}"
                                    Background="{DynamicResource CorkBrush}" BorderBrush="{DynamicResource CorkBrush}" Foreground="#2A0B14"
                                    FontWeight="SemiBold" ToolTip="Fetch all changes now at full speed (15–25 minutes) instead of waiting for the background updates.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Margin="0,0,8,0" FontSize="12" />
                                    <TextBlock Text="Update now" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="28,22,28,12" Visibility="{Binding IsSettingsPage, Converter={StaticResource CollapsedWhen}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TitleText}" FontSize="28" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding FetchDetailsCommand}" Margin="0,0,8,0" IsEnabled="{Binding Job.IsBusy, Converter={StaticResource InverseBool}}" 
                            ToolTip="Fetch tasting notes, grapes and food pairings for the listed wines (up to 1,000).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" Margin="0,0,7,0" FontSize="12" />
                            <TextBlock Text="Get details" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RateFilteredCommand}" Margin="0,0,8,0" IsEnabled="{Binding Job.IsBusy, Converter={StaticResource InverseBool}}" 
                            ToolTip="Find ratings for the listed wines (up to 500) that are missing them.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE735;" Margin="0,0,7,0" FontSize="12" />
                            <TextBlock Text="Rate listed" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RateSelectedCommand}" Margin="0,0,8,0" IsEnabled="{Binding Job.IsBusy, Converter={StaticResource InverseBool}}" 
                            ToolTip="Search every rating site for the selected wines (Ctrl/Shift-click to select several).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE735;" Margin="0,0,7,0" FontSize="12" />
                            <TextBlock Text="Rate selected" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ExportCommand}" Content="&#xE896;"
                            ToolTip="Export the listed wines to CSV or JSON" />
                </StackPanel>

                <!-- Search + filters -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search name, producer, grape, district or product number…" Padding="34,8,10,8" FontSize="14" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Margin="12,0,0,0" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
                    </Grid>
                    <ComboBox Grid.Column="1" Width="170" Margin="10,0,0,0" ItemsSource="{Binding Countries}"
                              SelectedItem="{Binding SelectedCountry}" MaxDropDownHeight="420" ToolTip="Country" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" ToolTip="Price range in kroner">
                        <TextBox Width="74" Tag="Min kr" Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                        <TextBlock Text="–" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Width="74" Tag="Max kr" Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    </StackPanel>
                    <ComboBox Grid.Column="3" Width="190" Margin="10,0,0,0" ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" ToolTip="Sort order" />
                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="Clear" Margin="6,0,0,0"
                            Command="{Binding ClearFiltersCommand}" ToolTip="Clear all filters" />
                </Grid>

                <!-- Type chips + score + availability -->
                <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
                    <ItemsControl ItemsSource="{Binding Categories}" DockPanel.Dock="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryFilter}">
                                <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding IsSelected}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding Code, Converter={StaticResource CategoryBrush}}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,2,0,0">
                        <TextBlock Text="{Binding MinScoreText}" Width="86" VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <Slider Width="110" Minimum="0" Maximum="96" SmallChange="1" LargeChange="5" Margin="8,0,16,0"
                                Value="{Binding MinScore}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                ToolTip="Only show wines whose best score (0–100) is at least this" />
                        <CheckBox Style="{StaticResource Switch}" Content="Available only" IsChecked="{Binding AvailableOnly}"
                                  VerticalAlignment="Center" ToolTip="Hide wines that cannot be bought or ordered right now" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Content: list + detail, or settings -->
            <Grid Grid.Row="1" Margin="28,0,28,16" Visibility="{Binding IsSettingsPage, Converter={StaticResource CollapsedWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="460" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="WineGrid" ItemsSource="{Binding Wines}" SelectedItem="{Binding SelectedWine}"
                                  Sorting="OnGridSorting" SelectionChanged="OnGridSelectionChanged" Margin="1,1,1,0"
                                  ClipboardCopyMode="IncludeHeader">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="WINE" Width="*" MinWidth="260" SortMemberPath="Name" CanUserSort="True" ClipboardContentBinding="{Binding Name}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Margin="2,0,12,0" VerticalAlignment="Center"
                                                         Fill="{Binding CategoryCode, Converter={StaticResource CategoryBrush}}"
                                                         ToolTip="{Binding Category}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,2,0,0"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding IsFavorite, Converter={StaticResource VisibleWhen}}" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="440">
                                                        <Run Text="{Binding Converter={StaticResource WineSubtitle}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ORIGIN" Width="150" SortMemberPath="Country" CanUserSort="True" ClipboardContentBinding="{Binding Country}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Country}" Style="{StaticResource CellText}" />
                                                <TextBlock Text="{Binding District}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="PRICE" Width="110" SortMemberPath="Price" CanUserSort="True" ClipboardContentBinding="{Binding Price}" HeaderStyle="{StaticResource RightHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Price, Converter={StaticResource Number}, ConverterParameter='kr {0:N0}'}"
                                                           Style="{StaticResource CellNumber}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PriceChange, Converter={StaticResource Number}, ConverterParameter='{}{0:+0;−0} kr'}"
                                                           FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{Binding PriceChange, Converter={StaticResource PriceChangeBrush}}"
                                                           Visibility="{Binding PriceChange, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="PER LITRE" Width="96" SortMemberPath="LitrePrice" CanUserSort="True" ClipboardContentBinding="{Binding LitrePrice}" HeaderStyle="{StaticResource RightHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LitrePrice, Converter={StaticResource Number}, ConverterParameter='{}{0:N0}'}"
                                                       Style="{StaticResource CellNumber}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SCORE" Width="92" SortMemberPath="BestScore" CanUserSort="True" ClipboardContentBinding="{Binding BestScore}" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="11" Padding="9,3" HorizontalAlignment="Center" MinWidth="44"
                                                    Background="{Binding BestScore, Converter={StaticResource ScoreBrush}}"
                                                    ToolTip="{Binding RatingSources, StringFormat='Average of {0} rating source(s), on a 0–100 scale'}"
                                                    Visibility="{Binding BestScore, Converter={StaticResource VisibleWhen}}">
                                                <TextBlock Text="{Binding BestScore, StringFormat={}{0:0.#}}" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="44" CanUserSort="False" ClipboardContentBinding="{Binding AvailabilityText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       ToolTip="{Binding AvailabilityText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE711;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AvailableOnline}" Value="True">
                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvailableInStores}" Value="True">
                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rate selected wines" Command="{Binding RateSelectedCommand}" />
                                    <MenuItem Header="Copy (Ctrl+C)" Command="ApplicationCommands.Copy" />
                                    <MenuItem Header="Open on vinmonopolet.no" Command="{Binding Detail.OpenVinmonopoletCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <TextBlock Text="{Binding EmptyListText}" Style="{StaticResource CaptionText}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360"
                                   Visibility="{Binding EmptyListText, Converter={StaticResource VisibleWhen}}" />

                        <!-- Empty catalogue -->
                        <Border Background="{DynamicResource HeroBrush}" CornerRadius="10" Margin="1"
                                Visibility="{Binding IsCatalogEmpty, Converter={StaticResource VisibleWhen}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                                <Image Source="Assets/vinliste-256.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,18" />
                                <TextBlock Text="Your wine list is empty" Style="{StaticResource TitleText}" TextAlignment="Center" />
                                <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,10,0,20"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Fetch Vinmonopolet's full wine range — red, white, rosé, sparkling, fortified and more. The first update reads about 27,000 wines and takes around 15–25 minutes; you can browse while it runs and stop it at any time." />
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCatalogCommand}" HorizontalAlignment="Center"
                                        Padding="22,10" IsEnabled="{Binding Job.IsBusy, Converter={StaticResource InverseBool}}">
                                    <TextBlock Text="Fetch the wine list" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,9">
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource CaptionText}" />
                        </Border>
                    </Grid>
                </Border>

                <views:WineDetailView Grid.Column="2" DataContext="{Binding Detail}" />
            </Grid>

            <views:SettingsView Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

            <!-- Activity panel: a mini terminal showing what background work is doing. -->
            <views:ActivityPanel Grid.Row="2" Margin="28,0,28,12" DataContext="{Binding Activity}"
                                 Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}" />

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="28,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Activity toggle, with the latest background line while the panel is closed. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Activity.Latest}" Style="{StaticResource CaptionText}" FontSize="11.5" MaxWidth="420"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Visibility="{Binding Activity.IsOpen, Converter={StaticResource CollapsedWhen}}" />
                        <ToggleButton IsChecked="{Binding Activity.IsOpen}" Style="{StaticResource FilterChip}" Margin="0" Padding="10,4"
                                      ToolTip="Show what Vinliste is doing in the background">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE756;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Activity" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9F5;" Margin="0,0,10,0" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding Job.IsBusy, Converter={StaticResource VisibleWhen}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Job.Message}" Style="{StaticResource CaptionText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Margin="0,5,0,0" Height="4" Value="{Binding Job.Progress, Mode=OneWay}" Maximum="1"
                                     IsIndeterminate="{Binding Job.IsIndeterminate}" MaxWidth="560" HorizontalAlignment="Left" Width="560"
                                     Visibility="{Binding Job.IsBusy, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Stop" Command="{Binding Job.CancelCommand}" Padding="14,4"
                            Visibility="{Binding Job.IsBusy, Converter={StaticResource VisibleWhen}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
