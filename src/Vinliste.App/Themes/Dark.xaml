<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aubergine night, wine-red highlights. -->
    <Color x:Key="PrimaryColor">#B4405A</Color>
    <Color x:Key="AccentColor">#D35C74</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1115" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#23171C" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2B1C22" />
    <SolidColorBrush x:Key="SurfaceRoseBrush" Color="#36212A" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#33232A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#4A2632" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3B2A31" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#523A43" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4E9EB" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BFA6AE" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A08893" />
    <SolidColorBrush x:Key="HeadingBrush" Color="#E58CA0" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#A8384F" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#BC4560" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#8E2C42" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFF5F2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E07890" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3D222B" />
    <SolidColorBrush x:Key="CorkBrush" Color="#C8A97E" />
    <SolidColorBrush x:Key="CorkSoftBrush" Color="#33291F" />
    <SolidColorBrush x:Key="GoldBrush" Color="#D9AE5B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6FBF8E" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F3328" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E2A54E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E06A78" />
    <SolidColorBrush x:Key="ScoreHighBrush" Color="#B4405A" />
    <SolidColorBrush x:Key="ScoreMidBrush" Color="#7E4452" />
    <SolidColorBrush x:Key="ScoreLowBrush" Color="#6A525A" />

    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Offset="0" Color="#2C0D16" />
        <GradientStop Offset="1" Color="#14070B" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavTextBrush" Color="#F5E6E9" />
    <SolidColorBrush x:Key="NavTextMutedBrush" Color="#A9858F" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#17FFFFFF" />

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#36212A" />
        <GradientStop Offset="1" Color="#2B2219" />
    </LinearGradientBrush>

    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="CaptionColor">#14070B</Color>
    <Color x:Key="CaptionTextColor">#F5E6E9</Color>
</ResourceDictionary>
