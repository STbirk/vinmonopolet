<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Vinliste</AssemblyName>
    <RootNamespace>Vinliste.App</RootNamespace>
    <ApplicationIcon>Assets\vinliste.ico</ApplicationIcon>
    <Product>Vinliste</Product>
    <Description>Vinmonopolet's wines with ratings, in a local catalogue.</Description>
    <Version>2.0.0</Version>
    <!-- Single-file publish must unpack SQLite's and WebView2's native DLLs. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vinliste.Core\Vinliste.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- Starter catalogue (built with tools/Vinliste.SeedBuilder); installed on first start. -->
  <ItemGroup Condition="Exists('Seed\vinliste-seed.db.gz')">
    <EmbeddedResource Include="Seed\vinliste-seed.db.gz" LogicalName="vinliste-seed.db.gz" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\vinliste.ico" />
    <Resource Include="Assets\vinliste-256.png" />
  </ItemGroup>

</Project>
