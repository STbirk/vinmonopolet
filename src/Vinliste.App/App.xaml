<Application x:Class="Vinliste.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Vinliste.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The palette must stay first: ThemeManager swaps index 0. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:VisibleWhenConverter x:Key="VisibleWhen" />
            <conv:VisibleWhenConverter x:Key="CollapsedWhen" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:ScoreBrushConverter x:Key="ScoreBrush" />
            <conv:CategoryBrushConverter x:Key="CategoryBrush" />
            <conv:PriceChangeBrushConverter x:Key="PriceChangeBrush" />
            <conv:NumberConverter x:Key="Number" />
            <conv:StockTextConverter x:Key="StockText" />
            <conv:EnumMatchConverter x:Key="EnumMatch" />
            <conv:WineSubtitleConverter x:Key="WineSubtitle" />
            <conv:ActiveOpacityConverter x:Key="ActiveOpacity" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
